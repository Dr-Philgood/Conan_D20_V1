    "minimum": "13",
    "verified": "13.350"
  },
  "authors": [
    {
      "name": "Philip N Clayton"
    }
  ],
  "esmodules": [
    "conan.mjs"
  ],
  "styles": [
    "styles/conan.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }

        "htmlFields": [
          "description"
        ]
      },
      "gear": {
        "htmlFields": [
          "description"
        ]
      },
      "sorcery": {
        "htmlFields": [
          "description",
          "requirements",
          "notes"
        ]
      },
      "feat": {
        "htmlFields": [
          "description",
          "benefit",
          "normal",
          "special"
        ]
      },
      "option": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "primaryTokenAttribute": "combat.hp",
  "secondaryTokenAttribute": null,
  "url": "https://github.com/Dr-Philgood/Conan_D20_V1",

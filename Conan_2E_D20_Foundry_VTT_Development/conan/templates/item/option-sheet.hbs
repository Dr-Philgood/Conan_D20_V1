{{!-- Character option reference sheet generated from the master workbook. --}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <h1><input name="name" type="text" value="{{item.name}}" placeholder="Option Name"></h1>
  </header>

  <section class="sheet-body">
    <div class="form-grid two-column">
      <label>Category<input type="text" name="system.category" value="{{system.category}}"></label>
      <label>Type<input type="text" name="system.subtype" value="{{system.subtype}}"></label>
      <label>Source<input type="text" name="system.source" value="{{system.source}}"></label>
      <label>Prerequisites<input type="text" name="system.prerequisites" value="{{system.prerequisites}}"></label>
    </div>

    <div class="item-description">
      <h2>Rules</h2>
      {{editor system.description target="system.description" button=true owner=owner editable=editable}}
    </div>
  </section>
</form>

{{!-- Play dashboard. Character creation and editable modifiers live in Advancement and Combat. --}}
<div class="play-heading"><div><h2>Ready for adventure</h2><p>Click an ability, save or attack to roll.</p></div><button type="button" class="sheet-link" data-sheet-tab="classes">Manage advancement <i class="fas fa-arrow-right" aria-hidden="true"></i></button></div>

<section class="panel ability-panel" aria-label="Ability checks">
  <div class="play-abilities">
    {{#each abilities}}
      <button type="button" class="ability-tile rollable-ability" data-ability="{{this.key}}" title="Roll {{this.label}} check">
        <span>{{this.short}}</span><strong>{{numberFormat this.data.mod sign=true}}</strong><small>{{this.label}} {{this.data.value}}</small>
      </button>
    {{/each}}
  </div>
</section>

<div class="play-columns">
  <section class="panel">
    <div class="panel-header"><h2>Defenses</h2><button type="button" class="sheet-link" data-sheet-tab="combat">Combat details</button></div>
    <div class="play-defense-grid">
      <div><span>Dodge</span><strong>{{system.combat.dodge.total}}</strong></div>
      <div><span>Parry</span><strong>{{system.combat.parry.total}}</strong></div>
      <div><span>Damage reduction</span><strong>{{system.combat.damageReduction.total}}</strong></div>
    </div>
    <div class="play-saves">
      {{#each saves}}
        <button type="button" class="rollable-save" data-save="{{this.key}}" title="Roll {{this.label}} save"><span>{{this.label}}</span><strong>{{numberFormat this.data.total sign=true}}</strong></button>
      {{/each}}
    </div>
    <div class="play-footnote"><span>Massive damage <strong>{{system.combat.massiveDamage.total}}</strong></span><span>Speed <strong>{{movement.speed.total}} ft.</strong></span></div>
  </section>

  <section class="panel">
    <div class="panel-header"><h2>Attacks</h2><button type="button" class="sheet-link" data-sheet-tab="combat">All weapons</button></div>
    <p class="sheet-hint">Pinned weapons, or equipped weapons when none are pinned.</p>
    <div class="play-weapon-list">
      {{#each quickWeapons}}
        <article class="play-weapon" data-item-id="{{this.id}}">
          <div><strong>{{this.name}}</strong><small>{{this.system.damage}} · AP {{this.system.armorPiercing}}</small></div>
          <div class="play-action-buttons"><button type="button" class="weapon-attack">Attack</button><button type="button" class="weapon-damage">Damage</button><button type="button" class="weapon-full-attack" title="Roll the full attack sequence">Full</button></div>
        </article>
      {{else}}
        <div class="sheet-empty"><p>No weapons ready.</p><button type="button" data-sheet-tab="combat">Add or equip a weapon</button></div>
      {{/each}}
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-header"><h2>Favorite skills</h2><button type="button" class="sheet-link" data-sheet-tab="skills">Browse skills</button></div>
  <div class="favorite-skill-grid">
    {{#each pinnedSkills}}<button type="button" class="rollable-skill" data-skill="{{this.key}}"><span>{{this.label}}</span><strong>{{numberFormat this.data.total sign=true}}</strong></button>{{/each}}
    {{#each pinnedCustomSkills}}<button type="button" class="rollable-custom-skill" data-group="{{this.group}}" data-skill-id="{{this.id}}"><span>{{this.label}}</span><strong>{{numberFormat this.data.total sign=true}}</strong></button>{{/each}}
  </div>
  {{#unless pinnedSkills.length}}{{#unless pinnedCustomSkills.length}}<div class="sheet-empty"><p>Keep your most-used skills here.</p><button type="button" data-sheet-tab="skills">Choose favorites in Skills</button></div>{{/unless}}{{/unless}}
</section>
